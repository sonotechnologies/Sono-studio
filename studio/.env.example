# Supabase (Project settings → API). Without these the app runs on a local
# file-backed dev store, which is refused in production.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base URL for pitch links. Change this one value when the domain is chosen.
NEXT_PUBLIC_SITE_URL=https://sono-studio.vercel.app

# Dev store only: the single login used when Supabase is not configured.
SONO_DEV_EMAIL=dev@sono.studio
SONO_DEV_PASSWORD=studio
