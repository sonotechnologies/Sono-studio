# Supabase (Project settings → API). Without these the app runs on a local
# file-backed dev store, which is refused in production.
NEXT_PUBLIC_SUPABASE_URL=
# The anon key or the newer publishable key (sb_publishable_...). NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY also works.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Encrypts AI and stock photo keys at rest. Generate with: openssl rand -base64 32
SONO_ENCRYPTION_KEY=

# Base URL for pitch links. Change this one value when the domain is chosen.
NEXT_PUBLIC_SITE_URL=https://sono-studio.vercel.app

# Dev store only: the single login used when Supabase is not configured.
SONO_DEV_EMAIL=dev@sono.studio
SONO_DEV_PASSWORD=studio

# Sono AI (experimental): records every AI request, redacted, in its own tables.
# Needs supabase/migrations/0012_sono_ai.sql. Leave empty to keep it off.
SONO_AI_ENABLED=
